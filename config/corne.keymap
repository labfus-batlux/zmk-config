#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500 // default: 600
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define LOWER 1
#define RAISE 2
#define MOUSE 3
#define PAD   4

/ {
        macros {
                arrow_r: arrow_r {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&kp MINUS &kp GT>;
                };
                arrow_l: arrow_l {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&kp LT &kp MINUS>;
                };
                lock_screen: lock_screen {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&kp LG(LC(Q))>;
                };
                emoji: emoji {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&kp LC(LG(SPACE))>;
                };
        };

        combos {
                compatible = "zmk,combos";

                // Paired symbols via adjacent key combos (default layer only)
                combo_lpar {
                        timeout-ms = <40>;
                        layers = <0>;
                        key-positions = <3 4>;   // E + R
                        bindings = <&kp LPAR>;
                };
                combo_rpar {
                        timeout-ms = <40>;
                        layers = <0>;
                        key-positions = <7 8>;   // U + I
                        bindings = <&kp RPAR>;
                };
                combo_lbkt {
                        timeout-ms = <40>;
                        layers = <0>;
                        key-positions = <15 16>; // D + F
                        bindings = <&kp LBKT>;
                };
                combo_rbkt {
                        timeout-ms = <40>;
                        layers = <0>;
                        key-positions = <19 20>; // J + K
                        bindings = <&kp RBKT>;
                };
                combo_lbrc {
                        timeout-ms = <40>;
                        layers = <0>;
                        key-positions = <27 28>; // C + V
                        bindings = <&kp LBRC>;
                };
                combo_rbrc {
                        timeout-ms = <40>;
                        layers = <0>;
                        key-positions = <31 32>; // M + ,
                        bindings = <&kp RBRC>;
                };
                combo_caps_word {
                        timeout-ms = <80>;
                        layers = <0>;
                        key-positions = <17 18>; // G + H
                        bindings = <&caps_word>;
                };
                combo_caps_lock {
                        timeout-ms = <80>;
                        layers = <0>;
                        key-positions = <5 6>;   // T + Y
                        bindings = <&kp CAPS>;
                };

                // One-hand PAD layer lock: press the outer two thumb keys of either
                // half together (one thumb across both). Same gesture unlocks.
                combo_pad_toggle_l {
                        timeout-ms = <50>;
                        require-prior-idle-ms = <150>;
                        layers = <BASE PAD>;
                        key-positions = <36 37>; // left outer + middle thumb
                        bindings = <&tog PAD>;
                };
                combo_pad_toggle_r {
                        timeout-ms = <50>;
                        require-prior-idle-ms = <150>;
                        layers = <BASE PAD>;
                        key-positions = <40 41>; // right middle + outer thumb
                        bindings = <&tog PAD>;
                };

                // Mirror-key media combos (wider timeout for cross-hand reach)
                combo_vol_up {
                        timeout-ms = <80>;
                        layers = <0>;
                        key-positions = <13 22>; // A + ;
                        bindings = <&kp C_VOL_UP>;
                };
                combo_vol_dn {
                        timeout-ms = <80>;
                        layers = <0>;
                        key-positions = <14 21>; // S + L
                        bindings = <&kp C_VOL_DN>;
                };
                combo_mute {
                        timeout-ms = <80>;
                        require-prior-idle-ms = <150>;
                        layers = <0>;
                        key-positions = <15 20>; // D + K
                        bindings = <&kp C_MUTE>;
                };
                combo_play_pause {
                        timeout-ms = <80>;
                        require-prior-idle-ms = <150>;
                        layers = <0>;
                        key-positions = <16 19>; // F + J
                        bindings = <&kp C_PP>;
                };
                combo_next {
                        timeout-ms = <80>;
                        require-prior-idle-ms = <150>;
                        layers = <0>;
                        key-positions = <4 7>;   // R + U
                        bindings = <&kp C_NEXT>;
                };
                combo_prev {
                        timeout-ms = <80>;
                        require-prior-idle-ms = <150>;
                        layers = <0>;
                        key-positions = <28 31>; // V + M
                        bindings = <&kp C_PREV>;
                };
        };

        // Layer 3 activates when both lower (1) and raise (2) are held
        conditional_layers {
                compatible = "zmk,conditional-layers";
                mouse_layer {
                        if-layers = <LOWER RAISE>;
                        then-layer = <MOUSE>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "BASE";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
                        >;
                };

                lower_layer {
                        display-name = "LOWER";
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | CTRL |SELA | SHFT| ALT | GUI | SS▢ |   | LFT | DWN |  UP | RGT |  F4 | F11  |
// | SHFT |UNDO | CUT |COPY |PASTE| SS▣ |   |     |     |     |     |     | ESC  |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp TAB    &kp N1     &kp N2    &kp N3   &kp N4   &kp N5         &kp N6   &kp N7   &kp N8   &kp N9    &kp N0  &kp BSPC
   &kp LCTRL  &kp LG(A)  &kp LSHFT &kp LALT &kp LGUI &kp LG(LS(N4)) &kp LEFT &kp DOWN &kp UP   &kp RIGHT &kp F4  &kp F11
   &kp LSHFT  &kp LG(Z)  &kp LG(X) &kp LG(C) &kp LG(V) &kp LG(LS(N3)) &trans  &trans   &trans   &trans    &trans  &kp ESC
                                    &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
                        >;
                };

                raise_layer {
                        display-name = "RAISE";
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | DEL  |
// | CTRL | LCK | EMJ |  <- |  -> |     |   |  -  |  =  |PGDN |PGUP |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |BRID |BRIU | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp TAB   &kp EXCL     &kp AT &kp LA(N3) &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK    &kp LPAR     &kp RPAR &kp DEL
   &kp LCTRL &lock_screen &emoji &arrow_l   &arrow_r &trans      &kp MINUS &kp EQUAL &kp PG_DN    &kp PG_UP    &kp BSLH &kp GRAVE
   &kp LSHFT &trans       &trans &trans     &trans   &trans      &kp UNDER &kp PLUS  &kp C_BRI_DN &kp C_BRI_UP &kp PIPE &kp TILDE
                             &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };

                mouse_layer {
                        display-name = "MOUSE";
// -----------------------------------------------------------------------------------------
// |      |     | ZM- |SC_U | ZM+ |     |   |     |LCLK | M_U |RCLK |     |      |
// |      |     |SC_L |SC_D |SC_R |     |   |     | M_L | M_D | M_R |     |      |
// |      |     |     |     |     |     |   | BT1 | BT2 | BT3 | BT4 | BT5 |BTCLR |
//                    |     |     |     |   |     |     |     |
                        bindings = <
   &trans &trans &kp LG(MINUS)  &msc SCRL_UP   &kp LG(EQUAL)   &trans  &trans       &mkp LCLK      &mmv MOVE_UP   &mkp RCLK       &trans       &trans
   &trans &trans &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_RIGHT &trans  &trans       &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans       &trans
   &trans &trans &trans         &trans         &trans          &trans  &bt BT_SEL 0 &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3    &bt BT_SEL 4 &bt BT_CLR
                                         &trans &trans &trans     &trans &trans &trans
                        >;
                };

                pad_layer {
                        display-name = "PAD";
// Locked one-hand layer; each half is complete on its own, so either hand can run it.
// The left half is an exact mirror image of the right: every finger does the same
// job on both hands. The right half is the reference (standard numpad fingering:
// index 7/4/1, middle 8/5/2, ring 9/6/3).
// Digits are real keypad codes (also drive Blender numpad views).
// BACK/FWD = Cmd+[ / Cmd+]. Scroll keys repeat while held.
// Lock/unlock: outer two thumb keys of either half together.
// -----------------------------------------------------------------------------------------
// | FWD  |BACK |  9  |  8  |  7  |SC_U |   |SC_U |  7  |  8  |  9  |BACK | FWD  |
// | MUTE |PLAY |  6  |  5  |  4  | ENT |   | ENT |  4  |  5  |  6  |PLAY | MUTE |
// | VOL+ |VOL- |  3  |  2  |  1  |SC_D |   |SC_D |  1  |  2  |  3  |VOL- | VOL+ |
//                    |BSPC |  .  |  0  |   |  0  |  .  |BSPC |
                        bindings = <
   &kp LG(RBKT) &kp LG(LBKT) &kp KP_N9 &kp KP_N8 &kp KP_N7 &msc SCRL_UP     &msc SCRL_UP   &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp LG(LBKT) &kp LG(RBKT)
   &kp C_MUTE   &kp C_PP     &kp KP_N6 &kp KP_N5 &kp KP_N4 &kp KP_ENTER     &kp KP_ENTER   &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp C_PP     &kp C_MUTE
   &kp C_VOL_UP &kp C_VOL_DN &kp KP_N3 &kp KP_N2 &kp KP_N1 &msc SCRL_DOWN   &msc SCRL_DOWN &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp C_VOL_DN &kp C_VOL_UP
                                  &kp BSPC &kp KP_DOT &kp KP_N0   &kp KP_N0 &kp KP_DOT &kp BSPC
                        >;
                };
        };
};
